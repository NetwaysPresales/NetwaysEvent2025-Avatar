# Application
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
ENABLE_DEMO_AUTH=true
INITIAL_USER_PASSWORD=replace-with-a-strong-initial-password

# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Azure Key Vault (optional when all secrets are supplied directly)
AZURE_KEY_VAULT_URL=https://your-key-vault.vault.azure.net/

# Azure OpenAI chat
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com
AZURE_OPENAI_API_KEY=replace-with-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure OpenAI embeddings
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-10-21

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=replace-with-search-admin-key
AZURE_SEARCH_INDEX_NAME=knowledge-chunks

# Azure Speech
AZURE_SPEECH_REGION=westeurope
AZURE_SPEECH_KEY=replace-with-speech-key
NEXT_PUBLIC_AZURE_SPEECH_REGION=westeurope

# Azure Blob Storage: use a connection string, or account name plus account key
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=replace-with-key;EndpointSuffix=core.windows.net
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=

# DOCX-to-PDF conversion
GOTENBERG_URL=https://your-gotenberg-service.example.com

# Default avatar presentation
NEXT_PUBLIC_AVATAR_CHARACTER=harry
NEXT_PUBLIC_AVATAR_STYLE=business
NEXT_PUBLIC_AVATAR_VOICE=en-US-AvaMultilingualNeural

# Optional Azure AD B2C authentication
AZURE_AD_B2C_TENANT_ID=
AZURE_AD_B2C_CLIENT_ID=
AZURE_AD_B2C_CLIENT_SECRET=
AZURE_AD_B2C_SIGNUP_SIGNIN_POLICY=

# Optional web search tool
TAVILY_API_KEY=

# Optional OpenAI-compatible fallback variables
OPENAI_API_KEY=
OPENAI_MODEL=
